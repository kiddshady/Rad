{
  "name": "rad",
  "private": true,
  "description": "Rad: un núcleo de app de escritorio y las pieles que nacen de él.",
  "author": "Kidd Shady · Umbrovex Systems",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "showcase": "npm start -w rad-showcase",
    "verify": "node tools/verify-core.mjs && node tools/verify-skins.mjs",
    "test": "node tools/test-store.mjs",
    "smoke": "node tools/smoke.mjs",
    "shots": "node tools/shots.mjs",
    "check": "npm run verify && npm run test && npm run smoke",
    "pack": "npm run pack -w rad-showcase",
    "smoke:pack": "node tools/smoke.mjs --exe \"apps/showcase/dist/win-unpacked/Rad.exe\"",
    "build": "npm run build -w rad-showcase"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "^26.18.0"
  }
}
