{
  "name": "daimon",
  "productName": "Daimon",
  "version": "0.2.0",
  "private": true,
  "description": "Daimon: an AI chat with several agents, each with its own provider, model, instructions and chats.",
  "author": "Kidd Shady · Umbrovex Systems",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/icon.mjs",
    "pack": "electron-builder --win dir --publish never",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@rad/core": "*",
    "@rad/skin-mono": "*"
  },
  "build": {
    "appId": "com.umbrovex.daimon",
    "productName": "Daimon",
    "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
    "electronVersion": "44.10.1",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "main/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Daimon-Setup-${version}.${ext}"
    }
  }
}
