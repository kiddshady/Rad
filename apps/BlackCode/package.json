{
  "name": "blackcode",
  "productName": "BlackCode",
  "version": "1.13.2",
  "private": true,
  "description": "BlackCode: an AI chat with several agents, each with its own provider, model, instructions and chats.",
  "author": "Kidd Shady · Umbrovex Systems",
  "main": "main.cjs",
  "scripts": {
    "start": "electron --enable-features=OverlayScrollbar .",
    "icon": "node scripts/icon.mjs",
    "katex": "node scripts/vendor-katex.mjs",
    "xterm": "node scripts/vendor-xterm.mjs",
    "pack": "electron-builder --win dir --publish never",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@lydell/node-pty": "1.2.0-beta.14",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/ciphers": "2.4.0",
    "@rad/core": "*",
    "@rad/skin-mono": "*",
    "esphome-client": "2.1.0"
  },
  "build": {
    "appId": "com.umbrovex.daimon",
    "productName": "BlackCode",
    "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
    "electronVersion": "44.10.1",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kiddshady",
      "repo": "blackcode-releases",
      "releaseType": "release"
    },
    "files": [
      "main.cjs",
      "main/**/*",
      "docs/**/*",
      "THIRD-PARTY.md",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/tray.ico",
      "build/tray-dark.ico",
      "package.json"
    ],
    "asarUnpack": [
      "main/tools/code-search-worker.cjs",
      "node_modules/@lydell/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BlackCode-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "motor",
        "to": "motor",
        "filter": [
          "*.py"
        ]
      }
    ]
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "katex": "0.18.1"
  }
}
