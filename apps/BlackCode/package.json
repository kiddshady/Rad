{
  "name": "daimon",
  "productName": "BlackCode",
  "version": "0.10.0",
  "private": true,
  "description": "BlackCode: an AI chat with several agents, each with its own provider, model, instructions and chats.",
  "author": "Kidd Shady · Umbrovex Systems",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/icon.mjs",
    "katex": "node scripts/vendor-katex.mjs",
    "pack": "electron-builder --win dir --publish never",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@rad/core": "*",
    "@rad/skin-mono": "*"
  },
  "build": {
    "appId": "com.umbrovex.daimon",
    "productName": "BlackCode",
    "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
    "electronVersion": "44.10.1",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kiddshady",
      "repo": "daimon-releases",
      "releaseType": "release"
    },
    "files": [
      "main.cjs",
      "main/**/*",
      "docs/**/*",
      "THIRD-PARTY.md",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "main/tools/code-search-worker.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BlackCode-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "katex": "0.18.1"
  }
}
